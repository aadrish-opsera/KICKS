# Copy to .env.local for local development. Never commit real secrets.
# In production, set these in the Vercel project dashboard.

# Required, server-only. Google Gemini API key for AI ranking. Never expose to client.
GEMINI_API_KEY=<your-gemini-api-key>

# Optional, server-only. The Sneaker Database API key if required by their free tier.
SNEAKER_DB_API_KEY=<your-sneaker-db-api-key>

# Optional, server-only. RapidAPI key for sneaker fallback providers.
RAPIDAPI_KEY=<your-rapidapi-key>

# Optional, CI/CD only. Vercel token for automated deploys (never commit the real value).
VERCEL_TOKEN=<your-vercel-token>

# Required, server-only. Sentry DSN for serverless function error tracking.
SENTRY_DSN=<your-sentry-dsn>

# Required, client-exposed (VITE_ prefix). Sentry DSN for React frontend error tracking.
VITE_SENTRY_DSN=<your-sentry-dsn>

# Optional, client-exposed (VITE_ prefix). Vercel Analytics ID for Web Vitals tracking.
VITE_VERCEL_ANALYTICS_ID=<your-analytics-id>

{
  "name": "kicks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit src/services/__tests__ src/utils/__tests__ src/components api/__tests__",
    "test:unit:watch": "vitest tests/unit src/services/__tests__ src/utils/__tests__ src/components",
    "test:unit:coverage": "vitest run --coverage tests/unit src/services/__tests__ src/utils/__tests__ src/components api/__tests__",
    "test:integration": "vitest run tests/integration api/__tests__ tests/api",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "test:e2e:chromium": "playwright test --config=playwright.config.mjs --project=chromium",
    "test:e2e:smoke": "node scripts/run-e2e-library-smoke.mjs",
    "test:perf:api": "vitest run tests/performance/api-latency.test.ts",
    "test:perf:client": "node scripts/run-perf-client.mjs",
    "test:perf:lighthouse": "lhci autorun --config=./lighthouserc.cjs",
    "test:perf:bundle": "node scripts/check-bundle-size.mjs",
    "test:perf": "npm run test:perf:api && npm run test:perf:bundle && npm run test:perf:client && npm run test:perf:lighthouse",
    "check:node-modules": "node scripts/check-node-modules.mjs",
    "check:sensitive-files": "node scripts/check-sensitive-files.mjs",
    "audit:check": "npm audit --omit=dev --audit-level=high",
    "audit:snyk": "node scripts/audit-snyk.mjs",
    "prepare": "husky",
    "lighthouse": "npm run test:perf:lighthouse"
  },
  "dependencies": {
    "@sentry/node": "^10.66.0",
    "@sentry/react": "^10.66.0",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/jsdom": "^28.0.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/edge": "^1.3.1",
    "@vercel/node": "^3.2.29",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "axe-core": "^4.12.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.5",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "vitest-axe": "^0.1.0"
  }
}
